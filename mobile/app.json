{
  "expo": {
    "name": "SilageGuard AI",
    "slug": "silageguard-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "silageguard",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.silageguard.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "SilageGuard needs camera access to inspect silage face for mould and texture abnormalities.",
        "NSBluetoothAlwaysUsageDescription": "SilageGuard uses Bluetooth to connect with the agricultural multi-sensor probe."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.silageguard.ai",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Grant camera access to scan silage faces for fungal spoilage."
        }
      ]
    ]
  }
}
