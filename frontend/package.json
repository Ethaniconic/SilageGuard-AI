{
  "name": "silageguard-ai-mobile",
  "version": "1.0.0",
  "main": "App.js",
  "scripts": {
    "start": "expo start --host lan --port 8081",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android --host lan --port 8081",
    "ios": "expo start --ios --host lan --port 8081",
    "web": "expo start --web --host lan --port 8081",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
