# SILAGEGUARD AI — Integration environment (frontend)
# Copy to `.env` and adjust. Expo loads EXPO_PUBLIC_* vars into the bundle.

# Backend base URL (no trailing slash)
#   iOS simulator / web  -> http://localhost:8000
#   Android emulator     -> http://10.0.2.2:8000
#   Physical device      -> http://<your-lan-ip>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Shared device secret. Must match DEVICE_PROVISIONING_SECRET in backend/.env.
# Enables the app to obtain a device-scoped token so offline batches can sync
# without a login screen. Leave empty to run the app fully offline-only.
EXPO_PUBLIC_DEVICE_SECRET=sg-dev-device-secret-change-me
